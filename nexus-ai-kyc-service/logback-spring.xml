<!-- ══════════════════════════════════════════════════════════════════
     nexus-ai-kyc-service — logback-spring.xml

     Improvements over the original:
       1. Added Loki appender — original had console only.
       2. Added ASYNC_LOKI with neverBlock — KYC pipeline includes
          blocking S3 download + AI call + MongoDB GridFS write;
          log shipping must not stall any of these.
       3. Added KYC-specific MDC fields:
            verificationId, userId, documentType, kycStatus, stage
          Injected by KycVerificationService per pipeline execution.
       4. Added customFields (version, environment).
       5. Added production profile.
       6. Added KYC pipeline audit logger — always INFO, so every
          AI decision in the verification pipeline is permanently logged
          (regulatory requirement in identity verification).
     ══════════════════════════════════════════════════════════════════ -->
<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <springProperty name="appName"
                    source="spring.application.name"
                    defaultValue="nexus-ai-kyc-service"/>
    <springProperty name="appVersion"
                    source="info.app.version"
                    defaultValue="1.0.0"/>
    <springProperty name="environment"
                    source="management.metrics.tags.environment"
                    defaultValue="local"/>
    <springProperty name="lokiUrl"
                    source="loki.url"
                    defaultValue="http://nexus-loki:3100/loki/api/v1/push"/>

    <!-- ══════════════════════════════════════════════════════════
         PLAIN TEXT CONSOLE — dev/local profile
     ══════════════════════════════════════════════════════════ -->
    <springProfile name="!docker,!production">
        <appender name="CONSOLE"
                  class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level traceId=%X{traceId:-} vId=%X{verificationId:-} stage=%X{stage:-} %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- ══════════════════════════════════════════════════════════
         STRUCTURED JSON + LOKI — docker + production profiles
     ══════════════════════════════════════════════════════════ -->
    <springProfile name="docker,production">

        <appender name="CONSOLE"
                  class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"service":"${appName}","version":"${appVersion}","environment":"${environment}"}</customFields>
                <includeMdcKeyName>traceId</includeMdcKeyName>
                <includeMdcKeyName>spanId</includeMdcKeyName>
                <!-- KYC pipeline MDC -->
                <includeMdcKeyName>verificationId</includeMdcKeyName>
                <includeMdcKeyName>userId</includeMdcKeyName>
                <includeMdcKeyName>documentType</includeMdcKeyName>
                <includeMdcKeyName>kycStatus</includeMdcKeyName>
                <includeMdcKeyName>stage</includeMdcKeyName>
                <shortenedLoggerNameLength>36</shortenedLoggerNameLength>
            </encoder>
        </appender>

        <appender name="LOKI"
                  class="com.github.loki4j.logback.Loki4jAppender">
            <http>
                <url>${lokiUrl}</url>
                <connectionTimeoutMs>3000</connectionTimeoutMs>
                <requestTimeoutMs>5000</requestTimeoutMs>
            </http>
            <format>
                <label>
                    <pattern>service=${appName},level=%level,environment=${environment}</pattern>
                </label>
                <message class="com.github.loki4j.logback.JsonLayout">
                    <pattern>
                        {"time":"%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z',UTC}",
                         "level":"%level",
                         "logger":"%logger{36}",
                         "thread":"%thread",
                         "traceId":"%X{traceId:-no-trace}",
                         "spanId":"%X{spanId:-no-span}",
                         "verificationId":"%X{verificationId:-}",
                         "userId":"%X{userId:-}",
                         "documentType":"%X{documentType:-}",
                         "kycStatus":"%X{kycStatus:-}",
                         "stage":"%X{stage:-}",
                         "message":"%message",
                         "service":"${appName}",
                         "environment":"${environment}"}%n
                    </pattern>
                </message>
            </format>
            <batchMaxItems>500</batchMaxItems>
            <batchMaxBytes>4194304</batchMaxBytes>
            <batchTimeoutMs>2000</batchTimeoutMs>
        </appender>

        <!-- neverBlock: S3 download + gpt-4o + MongoDB write chain;
             Loki must never add latency to this critical pipeline -->
        <appender name="ASYNC_LOKI"
                  class="ch.qos.logback.classic.AsyncAppender">
            <appender-ref ref="LOKI"/>
            <queueSize>10000</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <neverBlock>true</neverBlock>
        </appender>

        <!-- ══════════════════════════════════════════════════
             KYC PIPELINE AUDIT LOGGER — always INFO
             Every Stage 1 extraction and Stage 2 decision logged
             regardless of root level. Regulatory requirement.
         ══════════════════════════════════════════════════ -->
        <logger name="com.nexus.kyc.application" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_LOKI"/>
        </logger>

        <logger name="com.nexus.kyc" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_LOKI"/>
        </logger>

        <!-- Framework noise -->
        <logger name="org.springframework.ai" level="WARN"/>
        <logger name="org.springframework.kafka" level="WARN"/>
        <logger name="org.apache.kafka" level="WARN"/>
        <logger name="org.hibernate" level="WARN"/>
        <logger name="org.hibernate.SQL" level="WARN"/>
        <logger name="org.flywaydb" level="WARN"/>
        <logger name="org.springframework.data.mongodb" level="WARN"/>
        <logger name="com.netflix.eureka" level="WARN"/>
        <logger name="software.amazon.awssdk" level="WARN"/>

        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_LOKI"/>
        </root>

    </springProfile>

    <!-- Dev overrides -->
    <springProfile name="dev">
        <logger name="com.nexus.kyc" level="DEBUG"/>
        <logger name="org.springframework.ai" level="DEBUG"/>
        <logger name="org.hibernate.SQL" level="DEBUG"/>
        <logger name="software.amazon.awssdk" level="DEBUG"/>
    </springProfile>

</configuration>
