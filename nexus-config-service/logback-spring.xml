<!-- ══════════════════════════════════════════════════════════════════
     nexus-config-service — logback-spring.xml

     The file was 0 bytes. Created from scratch.

     Config service has simpler logging needs than other services:
     - No domain-specific MDC fields (no transactions, users, etc.)
     - traceId + service name sufficient
     - LOKI active only on docker/production profiles
     - neverBlock on ASYNC_LOKI — startup of ALL other services
       depends on this service being ready; log backpressure must
       never delay the config server's HTTP response time
     ══════════════════════════════════════════════════════════════════ -->
<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <springProperty name="appName"
                    source="spring.application.name"
                    defaultValue="nexus-config-service"/>
    <springProperty name="appVersion"
                    source="info.app.version"
                    defaultValue="1.0.0"/>
    <springProperty name="environment"
                    source="management.metrics.tags.environment"
                    defaultValue="local"/>
    <springProperty name="lokiUrl"
                    source="loki.url"
                    defaultValue="http://nexus-loki:3100/loki/api/v1/push"/>

    <!-- ══════════════════════════════════════════════════════════
         PLAIN TEXT CONSOLE — dev/local profile
     ══════════════════════════════════════════════════════════ -->
    <springProfile name="!docker,!production">
        <appender name="CONSOLE"
                  class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level service=nexus-config-service %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- ══════════════════════════════════════════════════════════
         STRUCTURED JSON + LOKI — docker + production profiles
     ══════════════════════════════════════════════════════════ -->
    <springProfile name="docker,production">

        <appender name="CONSOLE"
                  class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"service":"${appName}","version":"${appVersion}","environment":"${environment}"}</customFields>
                <includeMdcKeyName>traceId</includeMdcKeyName>
                <shortenedLoggerNameLength>36</shortenedLoggerNameLength>
            </encoder>
        </appender>

        <!-- ══════════════════════════════════════════════════
             LOKI — ships logs to Grafana Loki
             Dependency: com.github.loki4j:loki-logback-appender:1.5.2
             (add to pom.xml — see DEPENDENCIES.md)
         ══════════════════════════════════════════════════ -->
        <appender name="LOKI"
                  class="com.github.loki4j.logback.Loki4jAppender">
            <http>
                <url>${lokiUrl}</url>
                <connectionTimeoutMs>3000</connectionTimeoutMs>
                <requestTimeoutMs>5000</requestTimeoutMs>
            </http>
            <format>
                <label>
                    <pattern>service=${appName},level=%level,environment=${environment}</pattern>
                </label>
                <message class="com.github.loki4j.logback.JsonLayout">
                    <pattern>
                        {"time":"%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z',UTC}",
                         "level":"%level",
                         "logger":"%logger{36}",
                         "thread":"%thread",
                         "traceId":"%X{traceId:-no-trace}",
                         "message":"%message",
                         "service":"${appName}",
                         "environment":"${environment}"}%n
                    </pattern>
                </message>
            </format>
            <batchMaxItems>200</batchMaxItems>
            <batchMaxBytes>1048576</batchMaxBytes>
            <batchTimeoutMs>2000</batchTimeoutMs>
        </appender>

        <!-- neverBlock: all other services are waiting for this service
             to respond. Log shipping must never delay config responses. -->
        <appender name="ASYNC_LOKI"
                  class="ch.qos.logback.classic.AsyncAppender">
            <appender-ref ref="LOKI"/>
            <queueSize>5000</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <neverBlock>true</neverBlock>
        </appender>

        <!-- Config server activity -->
        <logger name="com.nexus.config" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_LOKI"/>
        </logger>
        <logger name="org.springframework.cloud.config" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_LOKI"/>
        </logger>

        <!-- Framework noise -->
        <logger name="org.springframework.cloud.bus" level="WARN"/>
        <logger name="org.apache.kafka" level="WARN"/>
        <logger name="com.netflix.eureka" level="WARN"/>
        <logger name="org.springframework.security" level="WARN"/>

        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_LOKI"/>
        </root>

    </springProfile>

</configuration>
