FROM eclipse-temurin:21-jre-alpine

RUN addgroup -S nexus && adduser -S nexus -G nexus
USER nexus
WORKDIR /app

COPY --chown=nexus:nexus target/quarkus-app/lib/ /app/lib/
COPY --chown=nexus:nexus target/quarkus-app/*.jar /app/
COPY --chown=nexus:nexus target/quarkus-app/app/ /app/app/
COPY --chown=nexus:nexus target/quarkus-app/quarkus/ /app/quarkus/
COPY --chown=nexus:nexus --chmod=755 docker-entrypoint.sh /app/docker-entrypoint.sh

EXPOSE 8096

HEALTHCHECK --interval=30s --timeout=5s \
    --start-period=15s --retries=3 \
    CMD wget --quiet --tries=1 --spider \
        http://localhost:8096/q/health || exit 1

ENTRYPOINT ["/app/docker-entrypoint.sh"]
CMD ["java", \
    "-Djava.util.logging.manager=org.jboss.logmanager.LogManager", \
    "-jar", "/app/quarkus-run.jar"]