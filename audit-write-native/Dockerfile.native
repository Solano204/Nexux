# Build stage — requires GraalVM CE 21
FROM ghcr.io/graalvm/graalvm-community:21 AS builder
WORKDIR /build
COPY .mvn/ .mvn/
COPY mvnw pom.xml ./
RUN ./mvnw dependency:go-offline -q
COPY src ./src
# Native compilation: ~3-5 minutes
RUN ./mvnw package -Pnative -DskipTests \
    -Dquarkus.native.container-build=false

# Runtime — minimal image
FROM debian:bookworm-slim AS runtime
RUN useradd -r -u 1001 nexus
COPY --from=builder \
    /build/target/nexus-audit-write-native-runner \
    /app/audit-write
RUN chown nexus:nexus /app/audit-write
USER nexus

HEALTHCHECK --interval=30s --timeout=5s \
    --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8096/q/health || exit 1

EXPOSE 8096
# ~90ms startup, ~28MB idle RSS
ENTRYPOINT ["/app/audit-write", \
    "-Dquarkus.http.port=8096"]