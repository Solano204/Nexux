<!-- ══════════════════════════════════════════════════════════════════
     nexus-ledger-service — logback-spring.xml

     The original logback-spring.xml was EMPTY (0 bytes).
     This replaces it with a complete structured logging configuration.

     Notable choices for the ledger service:
       1. Double-entry audit logger — always INFO at minimum, captures
          every posting, imbalance, and reconciliation result.
          This is the financial truth keeper — audit trail is critical.
       2. SERIALIZABLE retry logger — tracks optimistic lock failures
          and retry attempts (normal for this isolation level).
       3. MDC fields: postingId, ledgerEntryId, accountCode, sagaId
          injected by LedgerCommandService per transaction.
       4. neverBlock on ASYNC_LOKI — SERIALIZABLE transactions hold
          locks; Loki backpressure must never extend lock duration.
     ══════════════════════════════════════════════════════════════════ -->
<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <springProperty name="appName"
                    source="spring.application.name"
                    defaultValue="nexus-ledger-service"/>
    <springProperty name="appVersion"
                    source="info.app.version"
                    defaultValue="1.0.0"/>
    <springProperty name="environment"
                    source="management.metrics.tags.environment"
                    defaultValue="local"/>
    <springProperty name="lokiUrl"
                    source="loki.url"
                    defaultValue="http://nexus-loki:3100/loki/api/v1/push"/>

    <!-- ══════════════════════════════════════════════════════════
         CONSOLE — Structured JSON via LogstashEncoder
         Dependency: net.logstash.logback:logstash-logback-encoder:7.4
         (already in pom.xml)
     ══════════════════════════════════════════════════════════ -->
    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"${appName}","version":"${appVersion}","environment":"${environment}"}</customFields>
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>spanId</includeMdcKeyName>
            <includeMdcKeyName>postingId</includeMdcKeyName>
            <includeMdcKeyName>ledgerEntryId</includeMdcKeyName>
            <includeMdcKeyName>accountCode</includeMdcKeyName>
            <includeMdcKeyName>sagaId</includeMdcKeyName>
            <shortenedLoggerNameLength>36</shortenedLoggerNameLength>
        </encoder>
    </appender>

    <!-- ══════════════════════════════════════════════════════════
         LOKI — Active on docker/production profiles only
         Dependency: com.github.loki4j:loki-logback-appender:1.5.2
         (add to pom.xml — see DEPENDENCIES.md)
     ══════════════════════════════════════════════════════════ -->
    <appender name="LOKI"
              class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <url>${lokiUrl}</url>
            <connectionTimeoutMs>3000</connectionTimeoutMs>
            <requestTimeoutMs>5000</requestTimeoutMs>
        </http>
        <format>
            <label>
                <pattern>service=${appName},level=%level,environment=${environment}</pattern>
            </label>
            <message class="com.github.loki4j.logback.JsonLayout">
                <pattern>
                    {"time":"%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z',UTC}",
                     "level":"%level",
                     "logger":"%logger{36}",
                     "thread":"%thread",
                     "traceId":"%X{traceId:-no-trace}",
                     "spanId":"%X{spanId:-no-span}",
                     "postingId":"%X{postingId:-}",
                     "ledgerEntryId":"%X{ledgerEntryId:-}",
                     "accountCode":"%X{accountCode:-}",
                     "sagaId":"%X{sagaId:-}",
                     "message":"%message",
                     "service":"${appName}",
                     "environment":"${environment}"}%n
                </pattern>
            </message>
        </format>
        <batchMaxItems>1000</batchMaxItems>
        <batchMaxBytes>4194304</batchMaxBytes>
        <batchTimeoutMs>2000</batchTimeoutMs>
    </appender>

    <!-- CRITICAL: neverBlock — SERIALIZABLE locks must not be extended
         by Loki backpressure. Drop logs rather than delay commits. -->
    <appender name="ASYNC_LOKI"
              class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="LOKI"/>
        <queueSize>20000</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
    </appender>

    <!-- ══════════════════════════════════════════════════════════
         DOUBLE-ENTRY AUDIT LOGGER
         Always at INFO — captures every posting, debit/credit pair,
         imbalance exception, and reconciliation result.
         The financial truth keeper — immutable audit trail.
     ══════════════════════════════════════════════════════════ -->
    <logger name="com.nexus.ledger.application.command" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <springProfile name="docker,production">
            <appender-ref ref="ASYNC_LOKI"/>
        </springProfile>
    </logger>

    <!-- Reconciliation job results — always log at INFO -->
    <logger name="com.nexus.ledger.application.reconciliation" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <springProfile name="docker,production">
            <appender-ref ref="ASYNC_LOKI"/>
        </springProfile>
    </logger>

    <!-- ══════════════════════════════════════════════════════════
         APPLICATION LOGGERS
     ══════════════════════════════════════════════════════════ -->
    <logger name="com.nexus.ledger" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <springProfile name="docker,production">
            <appender-ref ref="ASYNC_LOKI"/>
        </springProfile>
    </logger>

    <!-- ══════════════════════════════════════════════════════════
         FRAMEWORK NOISE REDUCTION
     ══════════════════════════════════════════════════════════ -->
    <logger name="org.hibernate" level="WARN"/>
    <logger name="org.hibernate.SQL" level="WARN"/>
    <logger name="org.flywaydb" level="WARN"/>
    <logger name="org.springframework.data.mongodb" level="WARN"/>
    <logger name="org.springframework.kafka" level="WARN"/>
    <logger name="org.apache.kafka" level="WARN"/>
    <logger name="org.springframework.ai" level="WARN"/>
    <logger name="com.netflix.eureka" level="WARN"/>
    <logger name="com.netflix.discovery" level="WARN"/>
    <logger name="org.springframework.cloud" level="WARN"/>

    <!-- ══════════════════════════════════════════════════════════
         DEV OVERRIDES
     ══════════════════════════════════════════════════════════ -->
    <springProfile name="dev">
        <logger name="com.nexus.ledger" level="DEBUG"/>
        <logger name="org.hibernate.SQL" level="DEBUG"/>
        <logger name="org.flywaydb" level="DEBUG"/>
        <logger name="org.springframework.data.mongodb" level="DEBUG"/>
        <logger name="org.springframework.ai" level="DEBUG"/>
    </springProfile>

    <!-- ══════════════════════════════════════════════════════════
         ROOT
     ══════════════════════════════════════════════════════════ -->
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
        <springProfile name="docker,production">
            <appender-ref ref="ASYNC_LOKI"/>
        </springProfile>
    </root>

</configuration>
