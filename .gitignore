.idea/
target/
*.jar

# Secrets — NEVER commit these
.env
secrets/
*.jks
*.p12
*.pem


# Terraform state — never commit this
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# Terraform Lambda build artifacts (pip installs + zips, generated on apply)
terraform/build/

# Variable files that may contain secrets
terraform.tfvars
terraform.tfvars.dev
*.auto.tfvars

# Crash logs
crash.log
crash.*.log

# Override files (local dev overrides)
override.tf
override.tf.json
*_override.tf
*_override.tf.json


