{
  "id": null,
  "uid": "nexus-infra-deep-dive",
  "title": "Nexus Platform - Infrastructure Deep Dive",
  "description": "Server-side Postgres/MongoDB/Redis/Elasticsearch metrics via the exporters added alongside this dashboard (postgres_exporter, redis_exporter, mongodb_exporter, elasticsearch_exporter - see docker-compose-prod.yml). Metric names here are each exporter's own well-documented standard output, not verified against a live scrape (no exporter has actually run yet) - flag and fix any panel showing 'No data' once the stack is back up. Kafka broker-level metrics (under-replicated partitions, request handler idle ratio, log flush latency) are NOT included: they need a JMX-to-Prometheus exporter agent attached to the broker's own JVM (e.g. jmx_prometheus_javaagent), which isn't bundled in the stock confluentinc/cp-kafka:7.6.0 image and can't be added without either downloading that jar or building a custom broker image - out of scope for a dashboard-only change.",
  "tags": ["nexus", "infrastructure"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "PostgreSQL",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Connections per database",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "nexus-prometheus" },
      "targets": [
        { "expr": "pg_stat_database_numbackends{datname!~\"template.*|postgres\"}", "refId": "A", "legendFormat": "{{datname}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Replication slot lag",
      "description": "This platform's 6 Debezium CDC connectors each hold a logical replication slot - lag here means outbox events queued but not yet shipped to Kafka.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "nexus-prometheus" },
      "targets": [
        { "expr": "pg_replication_slots_pg_wal_lsn_diff", "refId": "A", "legendFormat": "{{slot_name}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 4,
      "type": "row",
      "title": "MongoDB",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Connections",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "nexus-prometheus" },
      "targets": [
        { "expr": "mongodb_connections{state=\"current\"}", "refId": "A", "legendFormat": "current" },
        { "expr": "mongodb_connections{state=\"available\"}", "refId": "B", "legendFormat": "available" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Op counters by type",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "nexus-prometheus" },
      "targets": [
        { "expr": "rate(mongodb_op_counters_total[5m])", "refId": "A", "legendFormat": "{{type}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 7,
      "type": "row",
      "title": "Redis",
      "description": "Single-node deployment - no replset/cluster metrics apply (mongodb_mongod_replset_member_state etc. skipped for the same reason).",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Memory used vs 1GB maxmemory",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "nexus-prometheus" },
      "targets": [
        { "expr": "redis_memory_used_bytes", "refId": "A", "legendFormat": "used" },
        { "expr": "redis_config_maxmemory", "refId": "B", "legendFormat": "maxmemory (1GB configured)" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Eviction rate, connected clients (vs 10000 limit), hit/miss ratio",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "nexus-prometheus" },
      "targets": [
        { "expr": "rate(redis_evicted_keys_total[5m])", "refId": "A", "legendFormat": "evictions/s" },
        { "expr": "redis_connected_clients", "refId": "B", "legendFormat": "connected clients" },
        { "expr": "rate(redis_keyspace_hits_total[5m]) / (rate(redis_keyspace_hits_total[5m]) + rate(redis_keyspace_misses_total[5m])) * 100", "refId": "C", "legendFormat": "hit ratio %" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Elasticsearch",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Cluster health",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "nexus-prometheus" },
      "targets": [
        { "expr": "elasticsearch_cluster_health_status", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "1": { "text": "GREEN", "color": "green" } } }],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "background" }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Index / shard count",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "nexus-prometheus" },
      "targets": [
        { "expr": "elasticsearch_cluster_health_active_primary_shards", "refId": "A", "legendFormat": "primary shards" },
        { "expr": "elasticsearch_cluster_health_active_shards", "refId": "B", "legendFormat": "total shards" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "value" }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "ES JVM heap (separate from app-service JVM dashboard)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "nexus-prometheus" },
      "targets": [
        { "expr": "elasticsearch_jvm_memory_used_bytes{area=\"heap\"} / elasticsearch_jvm_memory_max_bytes{area=\"heap\"} * 100", "refId": "A", "legendFormat": "heap used %" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Search / index latency",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "nexus-prometheus" },
      "targets": [
        { "expr": "rate(elasticsearch_indices_search_query_time_seconds[5m]) / rate(elasticsearch_indices_search_query_total[5m])", "refId": "A", "legendFormat": "avg search latency" },
        { "expr": "rate(elasticsearch_indices_indexing_index_time_seconds_total[5m]) / rate(elasticsearch_indices_indexing_index_total[5m])", "refId": "B", "legendFormat": "avg index latency" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    }
  ]
}
