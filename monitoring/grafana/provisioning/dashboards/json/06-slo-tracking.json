      "targets": [
        {
          "expr": "(sum(rate(saga_duration_seconds_count{sagaType=\"TRANSFER\"}[6h])) - sum(rate(saga_duration_seconds_bucket{sagaType=\"TRANSFER\", le=\"5\"}[6h]))) / sum(rate(saga_duration_seconds_count{sagaType=\"TRANSFER\"}[6h])) / 0.05",
