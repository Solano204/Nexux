      "title": "SLO 4 — Transfer saga under 5s (p95), end-to-end (balance reserve → fraud check → ledger post → finalize)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "collapsed": false,
      "panels": []
