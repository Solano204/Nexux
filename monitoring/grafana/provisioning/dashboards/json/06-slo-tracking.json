      "targets": [
        {
          "expr": "(sum(rate(saga_duration_seconds_count{sagaType=\"TRANSFER\"}[1h])) - sum(rate(saga_duration_seconds_bucket{sagaType=\"TRANSFER\", le=\"5\"}[1h]))) / sum(rate(saga_duration_seconds_count{sagaType=\"TRANSFER\"}[1h])) / 0.05",
          "refId": "A",
