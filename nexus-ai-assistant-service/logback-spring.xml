<!-- ══════════════════════════════════════════════════════════════════
     nexus-ai-assistant-service — logback-spring.xml

     The original logback-spring.xml was incomplete:
       - Only had a docker profile appender with no async wrapper
       - Loki appender missing entirely
       - No ASYNC_LOKI (SSE streaming threads must not block on Loki)
       - No MDC fields for conversationId, userId, toolName
       - Missing root logger (logs could be lost on unknown profiles)

     This replaces it with the full structured configuration.

     Key design choices for the AI assistant:
       1. Tool calling logger — always INFO, captures every tool
          invocation (balance check, transfer, fraud lookup) for audit
          and debugging agent behavior.
       2. Ollama fallback logger — INFO to track when the primary
          OpenAI client fails over to the local model.
       3. MDC fields: conversationId, userId, toolName, agentMode
          injected per request by FinancialAssistantAgent.
       4. neverBlock on ASYNC_LOKI — SSE streaming responses must not
          pause while Loki absorbs high-frequency token events.
       5. springProfile guard — Loki only on docker/production.
     ══════════════════════════════════════════════════════════════════ -->
<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <springProperty name="appName"
                    source="spring.application.name"
                    defaultValue="nexus-ai-assistant-service"/>
    <springProperty name="appVersion"
                    source="info.app.version"
                    defaultValue="1.0.0"/>
    <springProperty name="environment"
                    source="management.metrics.tags.environment"
                    defaultValue="local"/>
    <springProperty name="lokiUrl"
                    source="loki.url"
                    defaultValue="http://nexus-loki:3100/loki/api/v1/push"/>

    <!-- ══════════════════════════════════════════════════════════
         CONSOLE — Structured JSON via LogstashEncoder
         Dependency: net.logstash.logback:logstash-logback-encoder:7.4
         (already in pom.xml)
     ══════════════════════════════════════════════════════════ -->
    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"${appName}","version":"${appVersion}","environment":"${environment}"}</customFields>
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>spanId</includeMdcKeyName>
            <includeMdcKeyName>conversationId</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
            <includeMdcKeyName>toolName</includeMdcKeyName>
            <includeMdcKeyName>agentMode</includeMdcKeyName>
            <shortenedLoggerNameLength>36</shortenedLoggerNameLength>
        </encoder>
    </appender>

    <!-- ══════════════════════════════════════════════════════════
         LOKI — Active on docker/production profiles only
         Dependency: com.github.loki4j:loki-logback-appender:1.5.2
         (add to pom.xml — see DEPENDENCIES.md)
     ══════════════════════════════════════════════════════════ -->
    <appender name="LOKI"
              class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <url>${lokiUrl}</url>
            <connectionTimeoutMs>3000</connectionTimeoutMs>
            <requestTimeoutMs>5000</requestTimeoutMs>
        </http>
        <format>
            <label>
                <pattern>service=${appName},level=%level,environment=${environment}</pattern>
            </label>
            <message class="com.github.loki4j.logback.JsonLayout">
                <pattern>
                    {"time":"%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z',UTC}",
                     "level":"%level",
                     "logger":"%logger{36}",
                     "thread":"%thread",
                     "traceId":"%X{traceId:-no-trace}",
                     "spanId":"%X{spanId:-no-span}",
                     "conversationId":"%X{conversationId:-}",
                     "userId":"%X{userId:-}",
                     "toolName":"%X{toolName:-}",
                     "agentMode":"%X{agentMode:-}",
                     "message":"%message",
                     "service":"${appName}",
                     "environment":"${environment}"}%n
                </pattern>
            </message>
        </format>
        <batchMaxItems>500</batchMaxItems>
        <batchMaxBytes>4194304</batchMaxBytes>
        <batchTimeoutMs>2000</batchTimeoutMs>
    </appender>

    <!-- neverBlock: SSE streaming must not pause while Loki absorbs events -->
    <appender name="ASYNC_LOKI"
              class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="LOKI"/>
        <queueSize>20000</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
    </appender>

    <!-- ══════════════════════════════════════════════════════════
         TOOL CALLING LOGGER
         Always INFO — every tool invocation is audited.
         Tracks: balance checks, transfers initiated, fraud lookups,
         spending analysis, savings recommendations.
     ══════════════════════════════════════════════════════════ -->
    <logger name="com.nexus.assistant.agent.tools" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <springProfile name="docker,production">
            <appender-ref ref="ASYNC_LOKI"/>
        </springProfile>
    </logger>

    <!-- ══════════════════════════════════════════════════════════
         AGENT + CHAT SERVICE LOGGERS
     ══════════════════════════════════════════════════════════ -->
    <logger name="com.nexus.assistant.agent" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <springProfile name="docker,production">
            <appender-ref ref="ASYNC_LOKI"/>
        </springProfile>
    </logger>

    <logger name="com.nexus.assistant" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <springProfile name="docker,production">
            <appender-ref ref="ASYNC_LOKI"/>
        </springProfile>
    </logger>

    <!-- ══════════════════════════════════════════════════════════
         FRAMEWORK NOISE REDUCTION
     ══════════════════════════════════════════════════════════ -->
    <!-- Spring AI at WARN in prod — very chatty at INFO during streaming -->
    <logger name="org.springframework.ai" level="WARN"/>
    <logger name="org.springframework.kafka" level="WARN"/>
    <logger name="org.apache.kafka" level="WARN"/>
    <logger name="org.springframework.data.redis" level="WARN"/>
    <logger name="io.lettuce" level="WARN"/>
    <logger name="com.netflix.eureka" level="WARN"/>
    <logger name="com.netflix.discovery" level="WARN"/>
    <logger name="org.springframework.cloud" level="WARN"/>
    <logger name="reactor.netty" level="WARN"/>
    <logger name="io.netty" level="WARN"/>
    <!-- Ollama client at INFO — want to see fallback events -->
    <logger name="org.springframework.ai.ollama" level="INFO"/>

    <!-- ══════════════════════════════════════════════════════════
         DEV OVERRIDES
     ══════════════════════════════════════════════════════════ -->
    <springProfile name="dev">
        <logger name="com.nexus.assistant" level="DEBUG"/>
        <logger name="org.springframework.ai" level="DEBUG"/>
        <logger name="org.springframework.ai.ollama" level="DEBUG"/>
        <logger name="org.springframework.data.redis" level="DEBUG"/>
    </springProfile>

    <!-- ══════════════════════════════════════════════════════════
         ROOT — catches anything not matched above
     ══════════════════════════════════════════════════════════ -->
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
        <springProfile name="docker,production">
            <appender-ref ref="ASYNC_LOKI"/>
        </springProfile>
    </root>

</configuration>
