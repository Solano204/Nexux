<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.nexus.aws</groupId>
    <artifactId>nexus-fraud-alert-lambda</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>Nexus Fraud Alert Lambda</name>
    <description>
        SQS-triggered Lambda: processes high-severity fraud alerts (score >= 85).
        SnapStart: fraud attacks are bursty — cold start must be sub-500ms.
        DynamoDB: immutable forensic record (7-year TTL, KMS encrypted, PITR).
        SAR evaluation: CNBV 15-day deadline created automatically.
        SNS: compliance team + security ops immediate notification.
        CloudWatch: fraud.high.severity.count metric for security dashboard.
        ReportBatchItemFailures: isolates individual message failures.
        maxReceiveCount=2: DLQ + immediate page after 2 failures.
    </description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <aws.lambda.version>1.2.3</aws.lambda.version>
        <aws.sdk.version>2.25.0</aws.sdk.version>
        <jackson.version>2.17.0</jackson.version>
    </properties>

    <dependencies>

        <!-- ══════════════════════════════════════════════════
             AWS LAMBDA CORE + SQS EVENT MODEL
             ══════════════════════════════════════════════════ -->
        <dependency>
            <groupId>com.amazonaws</groupId>
            <artifactId>aws-lambda-java-core</artifactId>
            <version>${aws.lambda.version}</version>
        </dependency>
        <dependency>
            <groupId>com.amazonaws</groupId>
            <artifactId>aws-lambda-java-events</artifactId>
            <version>3.11.4</version>
        </dependency>
        <dependency>
            <groupId>com.amazonaws</groupId>
            <artifactId>aws-lambda-java-log4j2</artifactId>
            <version>1.6.0</version>
        </dependency>
        <!-- Bridges org.slf4j.Logger calls (used throughout this codebase)
             into log4j2. Without this, SLF4J finds no binding and all
             log.info/warn/error calls are silently dropped. -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j-impl</artifactId>
            <version>2.17.1</version>
        </dependency>

        <!-- ══════════════════════════════════════════════════
             AWS SDK v2 — DynamoDB, SNS, CloudWatch
             ══════════════════════════════════════════════════ -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>dynamodb</artifactId>
            <version>${aws.sdk.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sns</artifactId>
            <version>${aws.sdk.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>cloudwatch</artifactId>
            <version>${aws.sdk.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
            <version>${aws.sdk.version}</version>
        </dependency>

        <!-- ══════════════════════════════════════════════════
             X-RAY TRACING: not a dependency here.
             aws-xray-recorder-sdk-core crashes at cold-start init with
             NoSuchFieldError — its LocalizedSamplingStrategy static
             initializer references
             PropertyNamingStrategy.CAMEL_CASE_TO_LOWER_CASE_WITH_UNDERSCORES,
             a field removed by jackson-databind ${jackson.version}.
             Confirmed via a real AWS invoke. Lambda's platform-level
             Tracing=Active (terraform tracing_config) still traces the
             invocation itself without any SDK code.
             ══════════════════════════════════════════════════ -->

        <!-- ══════════════════════════════════════════════════
             JSON
             ══════════════════════════════════════════════════ -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- ══════════════════════════════════════════════════
             CRAC — SnapStart checkpoint/restore lifecycle
             Required for org.crac.Core and org.crac.Resource
             ══════════════════════════════════════════════════ -->
        <dependency>
            <groupId>io.github.crac</groupId>
            <artifactId>org-crac</artifactId>
            <version>0.1.3</version>
        </dependency>

        <!-- TESTING -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.11.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.25.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.2</version>
                <dependencies>
                    <!-- Without this, shading multiple log4j2 jars (log4j-core +
                         aws-lambda-java-log4j2) silently drops one jar's
                         META-INF/.../Log4j2Plugins.dat instead of merging them,
                         breaking log4j2's plugin discovery (e.g. PatternLayout)
                         at runtime with no build-time error. -->
                    <dependency>
                        <groupId>com.github.edwgiz</groupId>
                        <artifactId>maven-shade-plugin.log4j2-cachefile-transformer</artifactId>
                        <version>2.15</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="com.github.edwgiz.maven_shade_plugin.log4j2_cache_transformer.PluginsCacheFileTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>