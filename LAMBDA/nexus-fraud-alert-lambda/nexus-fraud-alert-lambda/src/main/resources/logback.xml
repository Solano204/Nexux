<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logback for AWS Lambda — Fraud Alert Handler.
  Lambda captures stdout → CloudWatch Logs.
  JSON not used here (Log4j2 Lambda appender handles structured output).
  Pattern includes request ID for correlation.
-->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

    <logger name="com.nexus.fraud.lambda" level="INFO"/>
    <logger name="software.amazon.awssdk" level="WARN"/>
    <logger name="software.amazon.awssdk.request" level="WARN"/>
    <logger name="com.amazonaws.xray" level="WARN"/>
</configuration>
