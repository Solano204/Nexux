<!-- ══════════════════════════════════════════════════════════════════
     nexus-fraud-service — logback-spring.xml

     Improvements over the original:
       1. Added Loki appender — original only had console output,
          no log shipping to Grafana Loki at all.
       2. Added ASYNC_LOKI with neverBlock — fraud decisions are on the
          critical SAGA path; Loki backpressure must not add latency.
       3. Added production profile (original only had docker/non-docker).
       4. Added fraud-specific MDC fields:
          transactionId, fraudDecisionId, riskScore, agentStep
       5. Added fraud agent logger at INFO (original was DEBUG always,
          which floods logs in production with ReAct reasoning traces).
       6. Added customFields (version, environment) to docker/prod encoder.
     ══════════════════════════════════════════════════════════════════ -->
<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <springProperty name="appName"
                    source="spring.application.name"
                    defaultValue="nexus-fraud-service"/>
    <springProperty name="appVersion"
                    source="info.app.version"
                    defaultValue="1.0.0"/>
    <springProperty name="environment"
                    source="management.metrics.tags.environment"
                    defaultValue="local"/>
    <springProperty name="lokiUrl"
                    source="loki.url"
                    defaultValue="http://nexus-loki:3100/loki/api/v1/push"/>

    <!-- ══════════════════════════════════════════════════════════
         PLAIN TEXT CONSOLE — dev/local (non-docker) profile
     ══════════════════════════════════════════════════════════ -->
    <springProfile name="!docker,!production">
        <appender name="CONSOLE"
                  class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level traceId=%X{traceId:-} tx=%X{transactionId:-} score=%X{riskScore:-} %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- ══════════════════════════════════════════════════════════
         STRUCTURED JSON CONSOLE — docker + production profiles
         Dependency: net.logstash.logback:logstash-logback-encoder:7.4
         (already in pom.xml)
     ══════════════════════════════════════════════════════════ -->
    <springProfile name="docker,production">

        <appender name="CONSOLE"
                  class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"service":"${appName}","version":"${appVersion}","environment":"${environment}"}</customFields>
                <includeMdcKeyName>traceId</includeMdcKeyName>
                <includeMdcKeyName>spanId</includeMdcKeyName>
                <!-- Fraud-specific MDC fields -->
                <includeMdcKeyName>transactionId</includeMdcKeyName>
                <includeMdcKeyName>fraudDecisionId</includeMdcKeyName>
                <includeMdcKeyName>riskScore</includeMdcKeyName>
                <includeMdcKeyName>agentStep</includeMdcKeyName>
                <includeMdcKeyName>toolName</includeMdcKeyName>
                <shortenedLoggerNameLength>36</shortenedLoggerNameLength>
            </encoder>
        </appender>

        <!-- ══════════════════════════════════════════════════
             LOKI — ships logs to Grafana Loki
             Dependency: com.github.loki4j:loki-logback-appender:1.5.2
             (add to pom.xml — see DEPENDENCIES.md)
         ══════════════════════════════════════════════════ -->
        <appender name="LOKI"
                  class="com.github.loki4j.logback.Loki4jAppender">
            <http>
                <url>${lokiUrl}</url>
                <connectionTimeoutMs>3000</connectionTimeoutMs>
                <requestTimeoutMs>5000</requestTimeoutMs>
            </http>
            <format>
                <label>
                    <pattern>service=${appName},level=%level,environment=${environment}</pattern>
                </label>
                <message class="com.github.loki4j.logback.JsonLayout">
                    <pattern>
                        {"time":"%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z',UTC}",
                         "level":"%level",
                         "logger":"%logger{36}",
                         "thread":"%thread",
                         "traceId":"%X{traceId:-no-trace}",
                         "spanId":"%X{spanId:-no-span}",
                         "transactionId":"%X{transactionId:-}",
                         "fraudDecisionId":"%X{fraudDecisionId:-}",
                         "riskScore":"%X{riskScore:-}",
                         "agentStep":"%X{agentStep:-}",
                         "toolName":"%X{toolName:-}",
                         "message":"%message",
                         "service":"${appName}",
                         "environment":"${environment}"}%n
                    </pattern>
                </message>
            </format>
            <batchMaxItems>500</batchMaxItems>
            <batchMaxBytes>4194304</batchMaxBytes>
            <batchTimeoutMs>2000</batchTimeoutMs>
        </appender>

        <!-- CRITICAL neverBlock: fraud decisions are on the SAGA path.
             A blocked logging call would delay transaction finalization. -->
        <appender name="ASYNC_LOKI"
                  class="ch.qos.logback.classic.AsyncAppender">
            <appender-ref ref="LOKI"/>
            <queueSize>20000</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <neverBlock>true</neverBlock>
        </appender>

        <!-- ══════════════════════════════════════════════════
             FRAUD DECISION AUDIT LOGGER — always INFO
             Every fraud decision logged regardless of root level.
         ══════════════════════════════════════════════════ -->
        <logger name="com.nexus.fraud.application" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_LOKI"/>
        </logger>

        <!-- Agent reasoning trace — INFO in prod (DEBUG is too verbose) -->
        <logger name="com.nexus.fraud.agent" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_LOKI"/>
        </logger>

        <!-- All other fraud service code -->
        <logger name="com.nexus.fraud" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_LOKI"/>
        </logger>

        <!-- Framework noise -->
        <logger name="org.springframework.ai" level="WARN"/>
        <logger name="org.springframework.kafka" level="WARN"/>
        <logger name="org.apache.kafka" level="WARN"/>
        <logger name="io.lettuce" level="WARN"/>
        <logger name="org.hibernate" level="WARN"/>
        <logger name="org.hibernate.SQL" level="WARN"/>
        <logger name="org.flywaydb" level="WARN"/>
        <logger name="com.netflix.eureka" level="WARN"/>
        <logger name="co.elastic" level="WARN"/>

        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_LOKI"/>
        </root>

    </springProfile>

    <!-- Dev overrides — verbose agent reasoning when profiling locally -->
    <springProfile name="dev">
        <logger name="com.nexus.fraud.agent" level="DEBUG"/>
        <logger name="org.springframework.ai" level="DEBUG"/>
        <logger name="org.hibernate.SQL" level="DEBUG"/>
    </springProfile>

</configuration>
