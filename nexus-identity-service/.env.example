# .env.example
# Copy this to .env and fill in real values before running docker-compose.prod.yml
# NEVER commit .env to Git

# PostgreSQL
POSTGRES_PASSWORD=change_me_strong_password

# Redis
REDIS_PASSWORD=change_me_strong_password

# JWT KeyStore (generate with scripts/generate-keystore.sh)
JWT_KEYSTORE_PASSWORD=change_me_strong_password

# AWS credentials (real AWS, not LocalStack)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
KYC_DOCUMENTS_BUCKET=nexus-kyc-documents-prod
KYC_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/nexus-kyc-documents-pending

# OpenAI (optional — KYC rejection explainer)
OPENAI_API_KEY=sk-...

# Grafana
GRAFANA_ADMIN_PASSWORD=change_me_strong_password

# Observability
TRACING_SAMPLE_RATE=0.1

# Docker image tag
IMAGE_TAG=latest
DOCKER_HUB_USERNAME=nexusplatform
