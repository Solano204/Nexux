<!-- ══════════════════════════════════════════════════════════════════
     nexus-audit-query-jvm — logback-spring.xml

     Improvements over the original:
       1. Added Loki appender — original had console only, no shipping
          to Grafana Loki.
       2. Added ASYNC_LOKI with neverBlock — compliance queries use
          StructuredTaskScope (JEP 505) for concurrent ES + pgvector
          lookups; log shipping must not stall those threads.
       3. Added compliance-specific MDC fields:
            queryType, complianceQueryId, targetUserId, severity
          Set by ComplianceQueryService per query execution.
       4. Added customFields (version, environment) to docker encoder.
       5. Added production profile (original only had docker/!docker).
       6. Added compliance audit logger — always INFO regardless of root
          level, so every AI compliance decision is permanently logged.
     ══════════════════════════════════════════════════════════════════ -->
<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <springProperty name="appName"
                    source="spring.application.name"
                    defaultValue="nexus-audit-query-jvm"/>
    <springProperty name="appVersion"
                    source="info.app.version"
                    defaultValue="1.0.0"/>
    <springProperty name="environment"
                    source="management.metrics.tags.environment"
                    defaultValue="local"/>
    <springProperty name="lokiUrl"
                    source="loki.url"
                    defaultValue="http://nexus-loki:3100/loki/api/v1/push"/>

    <!-- ══════════════════════════════════════════════════════════
         PLAIN TEXT CONSOLE — dev/local profile
     ══════════════════════════════════════════════════════════ -->
    <springProfile name="!docker,!production">
        <appender name="CONSOLE"
                  class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level traceId=%X{traceId:-} query=%X{complianceQueryId:-} type=%X{queryType:-} %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- ══════════════════════════════════════════════════════════
         STRUCTURED JSON + LOKI — docker + production profiles
         Dependencies:
           net.logstash.logback:logstash-logback-encoder (in pom.xml)
           com.github.loki4j:loki-logback-appender:1.5.2 (add to pom.xml)
     ══════════════════════════════════════════════════════════ -->
    <springProfile name="docker,production">

        <appender name="CONSOLE"
                  class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"service":"${appName}","version":"${appVersion}","environment":"${environment}"}</customFields>
                <includeMdcKeyName>traceId</includeMdcKeyName>
                <includeMdcKeyName>spanId</includeMdcKeyName>
                <!-- Compliance-specific MDC -->
                <includeMdcKeyName>complianceQueryId</includeMdcKeyName>
                <includeMdcKeyName>queryType</includeMdcKeyName>
                <includeMdcKeyName>targetUserId</includeMdcKeyName>
                <includeMdcKeyName>severity</includeMdcKeyName>
                <shortenedLoggerNameLength>36</shortenedLoggerNameLength>
            </encoder>
        </appender>

        <!-- ══════════════════════════════════════════════════
             LOKI — ships logs to Grafana Loki
         ══════════════════════════════════════════════════ -->
        <appender name="LOKI"
                  class="com.github.loki4j.logback.Loki4jAppender">
            <http>
                <url>${lokiUrl}</url>
                <connectionTimeoutMs>3000</connectionTimeoutMs>
                <requestTimeoutMs>5000</requestTimeoutMs>
            </http>
            <format>
                <label>
                    <pattern>service=${appName},level=%level,environment=${environment}</pattern>
                </label>
                <message class="com.github.loki4j.logback.JsonLayout">
                    <pattern>
                        {"time":"%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z',UTC}",
                         "level":"%level",
                         "logger":"%logger{36}",
                         "thread":"%thread",
                         "traceId":"%X{traceId:-no-trace}",
                         "spanId":"%X{spanId:-no-span}",
                         "complianceQueryId":"%X{complianceQueryId:-}",
                         "queryType":"%X{queryType:-}",
                         "targetUserId":"%X{targetUserId:-}",
                         "severity":"%X{severity:-}",
                         "message":"%message",
                         "service":"${appName}",
                         "environment":"${environment}"}%n
                    </pattern>
                </message>
            </format>
            <batchMaxItems>500</batchMaxItems>
            <batchMaxBytes>4194304</batchMaxBytes>
            <batchTimeoutMs>2000</batchTimeoutMs>
        </appender>

        <!-- neverBlock: StructuredTaskScope threads must not stall
             on Loki backpressure during concurrent query execution -->
        <appender name="ASYNC_LOKI"
                  class="ch.qos.logback.classic.AsyncAppender">
            <appender-ref ref="LOKI"/>
            <queueSize>10000</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <neverBlock>true</neverBlock>
        </appender>

        <!-- ══════════════════════════════════════════════════
             COMPLIANCE AUDIT LOGGER — always INFO
             Every ComplianceQueryResult is logged regardless of
             root level. Regulatory requirement: all AI compliance
             decisions must be permanently traceable.
         ══════════════════════════════════════════════════ -->
        <logger name="com.nexus.audit.query.application" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_LOKI"/>
        </logger>

        <logger name="com.nexus.audit.query" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_LOKI"/>
        </logger>

        <!-- Framework noise -->
        <logger name="org.springframework.ai" level="WARN"/>
        <logger name="org.springframework.data.elasticsearch" level="WARN"/>
        <logger name="org.springframework.data.mongodb" level="WARN"/>
        <logger name="com.netflix.eureka" level="WARN"/>
        <logger name="co.elastic" level="WARN"/>
        <logger name="org.hibernate" level="WARN"/>

        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_LOKI"/>
        </root>

    </springProfile>

    <!-- Dev overrides -->
    <springProfile name="dev">
        <logger name="com.nexus.audit.query" level="DEBUG"/>
        <logger name="org.springframework.ai" level="DEBUG"/>
        <logger name="org.springframework.data.elasticsearch" level="DEBUG"/>
    </springProfile>

</configuration>
