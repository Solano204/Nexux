<!-- ══════════════════════════════════════════════════════════════════
     nexus-transaction-service — logback-spring.xml

     This service had no logback-spring.xml (only a logging.pattern.console
     in application.yml). This file replaces that with proper structured
     JSON logging + Loki shipping on docker/production profiles.

     Key design choices for the transaction service:
       1. Transaction financial logger — always INFO, captures every
          state transition through the 16-state lifecycle for audit.
       2. Kafka Streams logger — separate WARN logger for streams
          noise (KafkaStreams itself is very chatty at INFO).
       3. MDC fields: transactionId, accountId, sagaId, userId
          injected per request by TransactionCommandService.
       4. neverBlock on ASYNC_LOKI — financial transaction processing
          must never be delayed by log shipping backpressure.
     ══════════════════════════════════════════════════════════════════ -->
<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <springProperty name="appName"
                    source="spring.application.name"
                    defaultValue="nexus-transaction-service"/>
    <springProperty name="appVersion"
                    source="info.app.version"
                    defaultValue="1.0.0"/>
    <springProperty name="environment"
                    source="management.metrics.tags.environment"
                    defaultValue="local"/>
    <springProperty name="lokiUrl"
                    source="loki.url"
                    defaultValue="http://nexus-loki:3100/loki/api/v1/push"/>

    <!-- ══════════════════════════════════════════════════════════
         CONSOLE — Structured JSON via LogstashEncoder
         Dependency: net.logstash.logback:logstash-logback-encoder:7.4
         (already in your pom.xml)
     ══════════════════════════════════════════════════════════ -->
    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"${appName}","version":"${appVersion}","environment":"${environment}"}</customFields>
            <!-- MDC fields set by TransactionCommandService / SAGA handlers -->
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>spanId</includeMdcKeyName>
            <includeMdcKeyName>transactionId</includeMdcKeyName>
            <includeMdcKeyName>accountId</includeMdcKeyName>
            <includeMdcKeyName>sagaId</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
            <shortenedLoggerNameLength>36</shortenedLoggerNameLength>
        </encoder>
    </appender>

    <!-- ══════════════════════════════════════════════════════════
         LOKI — Active on docker/production profiles only
         Dependency: com.github.loki4j:loki-logback-appender:1.5.2
         (add to pom.xml — see DEPENDENCIES.md)
     ══════════════════════════════════════════════════════════ -->
    <appender name="LOKI"
              class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <url>${lokiUrl}</url>
            <connectionTimeoutMs>3000</connectionTimeoutMs>
            <requestTimeoutMs>5000</requestTimeoutMs>
        </http>
        <format>
            <label>
                <pattern>service=${appName},level=%level,environment=${environment}</pattern>
            </label>
            <message class="com.github.loki4j.logback.JsonLayout">
                <pattern>
                    {"time":"%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z',UTC}",
                     "level":"%level",
                     "logger":"%logger{36}",
                     "thread":"%thread",
                     "traceId":"%X{traceId:-no-trace}",
                     "spanId":"%X{spanId:-no-span}",
                     "transactionId":"%X{transactionId:-}",
                     "accountId":"%X{accountId:-}",
                     "sagaId":"%X{sagaId:-}",
                     "userId":"%X{userId:-}",
                     "message":"%message",
                     "service":"${appName}",
                     "environment":"${environment}"}%n
                </pattern>
            </message>
        </format>
        <batchMaxItems>1000</batchMaxItems>
        <batchMaxBytes>4194304</batchMaxBytes>
        <batchTimeoutMs>2000</batchTimeoutMs>
    </appender>

    <!-- neverBlock: financial transaction state transitions MUST NOT
         be delayed by Loki backpressure under any circumstances -->
    <appender name="ASYNC_LOKI"
              class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="LOKI"/>
        <queueSize>20000</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
    </appender>

    <!-- ══════════════════════════════════════════════════════════
         TRANSACTION FINANCIAL AUDIT LOGGER
         Always at INFO — captures every 16-state lifecycle transition.
         TransactionCommandService logs to com.nexus.transaction.financial.*
     ══════════════════════════════════════════════════════════ -->
    <logger name="com.nexus.transaction.financial" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <springProfile name="docker,production">
            <appender-ref ref="ASYNC_LOKI"/>
        </springProfile>
    </logger>

    <!-- ══════════════════════════════════════════════════════════
         APPLICATION LOGGERS
     ══════════════════════════════════════════════════════════ -->
    <logger name="com.nexus.transaction" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <springProfile name="docker,production">
            <appender-ref ref="ASYNC_LOKI"/>
        </springProfile>
    </logger>

    <!-- ══════════════════════════════════════════════════════════
         KAFKA STREAMS — suppress chatty INFO-level streams logs
         that would flood Loki with window store compaction noise
     ══════════════════════════════════════════════════════════ -->
    <logger name="org.apache.kafka.streams" level="WARN"/>
    <logger name="org.apache.kafka.clients" level="WARN"/>
    <logger name="org.apache.kafka.common" level="WARN"/>
    <logger name="org.springframework.kafka" level="WARN"/>

    <!-- ══════════════════════════════════════════════════════════
         FRAMEWORK NOISE REDUCTION
     ══════════════════════════════════════════════════════════ -->
    <logger name="org.hibernate" level="WARN"/>
    <logger name="org.hibernate.SQL" level="WARN"/>
    <logger name="org.flywaydb" level="WARN"/>
    <logger name="org.springframework.data.elasticsearch" level="WARN"/>
    <logger name="com.netflix.eureka" level="WARN"/>
    <logger name="com.netflix.discovery" level="WARN"/>
    <logger name="org.springframework.cloud" level="WARN"/>
    <logger name="co.elastic" level="WARN"/>

    <!-- ══════════════════════════════════════════════════════════
         DEV OVERRIDES — verbose output when running locally
     ══════════════════════════════════════════════════════════ -->
    <springProfile name="dev">
        <logger name="com.nexus.transaction" level="DEBUG"/>
        <logger name="org.hibernate.SQL" level="DEBUG"/>
        <logger name="org.apache.kafka.streams" level="DEBUG"/>
        <logger name="org.springframework.data.elasticsearch" level="DEBUG"/>
    </springProfile>

    <!-- ══════════════════════════════════════════════════════════
         ROOT
     ══════════════════════════════════════════════════════════ -->
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
        <springProfile name="docker,production">
            <appender-ref ref="ASYNC_LOKI"/>
        </springProfile>
    </root>

</configuration>
