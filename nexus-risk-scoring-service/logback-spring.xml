<!-- ══════════════════════════════════════════════════════════════════
     nexus-risk-scoring-service — logback-spring.xml

     The service had NO logback-spring.xml. Created from scratch.

     Key design choices:
       1. Risk scoring audit logger — always INFO. Every RiskProfile
          computation result is logged for compliance audit trail.
          Risk scores drive credit decisions and fraud detection.
       2. Nightly batch logger — always INFO. Batch start/end + per-user
          completion logged for monitoring job progress.
       3. MDC fields: userId, riskTier, computationId, toolName, agentStep
          Injected by RiskScoringAgent per computation.
       4. neverBlock on ASYNC_LOKI — Virtual Thread pool processes users
          in parallel during nightly batch; Loki must never throttle them.
       5. Spring AI at WARN in production — extremely chatty during
          Plan-then-Act agent loops (each tool call logs at INFO).
     ══════════════════════════════════════════════════════════════════ -->
<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <springProperty name="appName"
                    source="spring.application.name"
                    defaultValue="nexus-risk-scoring-service"/>
    <springProperty name="appVersion"
                    source="info.app.version"
                    defaultValue="1.0.0"/>
    <springProperty name="environment"
                    source="management.metrics.tags.environment"
                    defaultValue="local"/>
    <springProperty name="lokiUrl"
                    source="loki.url"
                    defaultValue="http://nexus-loki:3100/loki/api/v1/push"/>

    <springProfile name="!docker,!production">
        <appender name="CONSOLE"
                  class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level traceId=%X{traceId:-} userId=%X{userId:-} tier=%X{riskTier:-} %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="docker,production">

        <appender name="CONSOLE"
                  class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"service":"${appName}","version":"${appVersion}","environment":"${environment}"}</customFields>
                <includeMdcKeyName>traceId</includeMdcKeyName>
                <includeMdcKeyName>spanId</includeMdcKeyName>
                <includeMdcKeyName>userId</includeMdcKeyName>
                <includeMdcKeyName>riskTier</includeMdcKeyName>
                <includeMdcKeyName>computationId</includeMdcKeyName>
                <includeMdcKeyName>toolName</includeMdcKeyName>
                <includeMdcKeyName>agentStep</includeMdcKeyName>
                <shortenedLoggerNameLength>36</shortenedLoggerNameLength>
            </encoder>
        </appender>

        <appender name="LOKI"
                  class="com.github.loki4j.logback.Loki4jAppender">
            <http>
                <url>${lokiUrl}</url>
                <connectionTimeoutMs>3000</connectionTimeoutMs>
                <requestTimeoutMs>5000</requestTimeoutMs>
            </http>
            <format>
                <label>
                    <pattern>service=${appName},level=%level,environment=${environment}</pattern>
                </label>
                <message class="com.github.loki4j.logback.JsonLayout">
                    <pattern>
                        {"time":"%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z',UTC}",
                         "level":"%level",
                         "logger":"%logger{36}",
                         "thread":"%thread",
                         "traceId":"%X{traceId:-no-trace}",
                         "spanId":"%X{spanId:-no-span}",
                         "userId":"%X{userId:-}",
                         "riskTier":"%X{riskTier:-}",
                         "computationId":"%X{computationId:-}",
                         "toolName":"%X{toolName:-}",
                         "agentStep":"%X{agentStep:-}",
                         "message":"%message",
                         "service":"${appName}",
                         "environment":"${environment}"}%n
                    </pattern>
                </message>
            </format>
            <batchMaxItems>1000</batchMaxItems>
            <batchMaxBytes>4194304</batchMaxBytes>
            <batchTimeoutMs>2000</batchTimeoutMs>
        </appender>

        <!-- neverBlock: Virtual Thread pool runs many users in parallel
             during nightly batch; log shipping must not throttle them -->
        <appender name="ASYNC_LOKI"
                  class="ch.qos.logback.classic.AsyncAppender">
            <appender-ref ref="LOKI"/>
            <queueSize>20000</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <neverBlock>true</neverBlock>
        </appender>

        <!-- Risk scoring audit — always INFO, compliance requirement -->
        <logger name="com.nexus.risk.agent" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_LOKI"/>
        </logger>

        <!-- Nightly batch — always INFO for operational monitoring -->
        <logger name="com.nexus.risk.application.batch" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_LOKI"/>
        </logger>

        <logger name="com.nexus.risk" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_LOKI"/>
        </logger>

        <!-- Spring AI: WARN — Plan-then-Act agent is very chatty at INFO -->
        <logger name="org.springframework.ai" level="WARN"/>
        <logger name="org.springframework.kafka" level="WARN"/>
        <logger name="org.hibernate" level="WARN"/>
        <logger name="org.flywaydb" level="WARN"/>
        <logger name="io.lettuce" level="WARN"/>
        <logger name="co.elastic" level="WARN"/>
        <logger name="com.netflix.eureka" level="WARN"/>

        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_LOKI"/>
        </root>

    </springProfile>

    <springProfile name="dev">
        <logger name="com.nexus.risk" level="DEBUG"/>
        <logger name="org.springframework.ai" level="DEBUG"/>
        <logger name="org.hibernate.SQL" level="DEBUG"/>
    </springProfile>

</configuration>
