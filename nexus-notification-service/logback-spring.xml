<!-- ══════════════════════════════════════════════════════════════════
     nexus-notification-service — logback-spring.xml

     The original logback-spring.xml file was EMPTY (0 bytes).
     This replaces it with a complete structured logging configuration.

     Notable choices for the notification service:
       1. Channel delivery logger — always INFO, tracks every delivery
          attempt per channel (email/push/SMS/in-app) for SLA reporting.
       2. AI content generation logger — tracks every OpenAI call and
          fallback activation so you can measure AI vs template usage.
       3. MDC fields: notificationId, userId, channel, eventType
          injected by NotificationProcessingService.
       4. neverBlock on ASYNC_LOKI — Kafka consumer threads must not
          stall while Loki absorbs high burst of notification events.
     ══════════════════════════════════════════════════════════════════ -->
<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <springProperty name="appName"
                    source="spring.application.name"
                    defaultValue="nexus-notification-service"/>
    <springProperty name="appVersion"
                    source="info.app.version"
                    defaultValue="1.0.0"/>
    <springProperty name="environment"
                    source="management.metrics.tags.environment"
                    defaultValue="local"/>
    <springProperty name="lokiUrl"
                    source="loki.url"
                    defaultValue="http://nexus-loki:3100/loki/api/v1/push"/>

    <!-- ══════════════════════════════════════════════════════════
         CONSOLE — Structured JSON via LogstashEncoder
         Dependency: net.logstash.logback:logstash-logback-encoder:7.4
         (already in pom.xml)
     ══════════════════════════════════════════════════════════ -->
    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"${appName}","version":"${appVersion}","environment":"${environment}"}</customFields>
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>spanId</includeMdcKeyName>
            <includeMdcKeyName>notificationId</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
            <includeMdcKeyName>channel</includeMdcKeyName>
            <includeMdcKeyName>eventType</includeMdcKeyName>
            <shortenedLoggerNameLength>36</shortenedLoggerNameLength>
        </encoder>
    </appender>

    <!-- ══════════════════════════════════════════════════════════
         LOKI — Active on docker/production profiles only
         Dependency: com.github.loki4j:loki-logback-appender:1.5.2
         (add to pom.xml — see DEPENDENCIES.md)
     ══════════════════════════════════════════════════════════ -->
    <appender name="LOKI"
              class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <url>${lokiUrl}</url>
            <connectionTimeoutMs>3000</connectionTimeoutMs>
            <requestTimeoutMs>5000</requestTimeoutMs>
        </http>
        <format>
            <label>
                <pattern>service=${appName},level=%level,environment=${environment}</pattern>
            </label>
            <message class="com.github.loki4j.logback.JsonLayout">
                <pattern>
                    {"time":"%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z',UTC}",
                     "level":"%level",
                     "logger":"%logger{36}",
                     "thread":"%thread",
                     "traceId":"%X{traceId:-no-trace}",
                     "spanId":"%X{spanId:-no-span}",
                     "notificationId":"%X{notificationId:-}",
                     "userId":"%X{userId:-}",
                     "channel":"%X{channel:-}",
                     "eventType":"%X{eventType:-}",
                     "message":"%message",
                     "service":"${appName}",
                     "environment":"${environment}"}%n
                </pattern>
            </message>
        </format>
        <batchMaxItems>1000</batchMaxItems>
        <batchMaxBytes>4194304</batchMaxBytes>
        <batchTimeoutMs>2000</batchTimeoutMs>
    </appender>

    <!-- neverBlock: Kafka consumer threads must not stall on notification bursts -->
    <appender name="ASYNC_LOKI"
              class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="LOKI"/>
        <queueSize>20000</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
    </appender>

    <!-- ══════════════════════════════════════════════════════════
         CHANNEL DELIVERY LOGGER
         Always INFO — every send attempt per channel logged
         for SLA and delivery rate reporting in Grafana.
     ══════════════════════════════════════════════════════════ -->
    <logger name="com.nexus.notification.application.channel" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <springProfile name="docker,production">
            <appender-ref ref="ASYNC_LOKI"/>
        </springProfile>
    </logger>

    <!-- ══════════════════════════════════════════════════════════
         AI CONTENT GENERATION LOGGER
         Always INFO — tracks OpenAI calls, fallback activations,
         and retry attempts (useful for cost monitoring).
     ══════════════════════════════════════════════════════════ -->
    <logger name="com.nexus.notification.application.ai" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <springProfile name="docker,production">
            <appender-ref ref="ASYNC_LOKI"/>
        </springProfile>
    </logger>

    <!-- ══════════════════════════════════════════════════════════
         APPLICATION LOGGERS
     ══════════════════════════════════════════════════════════ -->
    <logger name="com.nexus.notification" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <springProfile name="docker,production">
            <appender-ref ref="ASYNC_LOKI"/>
        </springProfile>
    </logger>

    <!-- ══════════════════════════════════════════════════════════
         FRAMEWORK NOISE REDUCTION
     ══════════════════════════════════════════════════════════ -->
    <logger name="org.springframework.data.mongodb" level="WARN"/>
    <logger name="org.springframework.kafka" level="WARN"/>
    <logger name="org.apache.kafka" level="WARN"/>
    <logger name="org.springframework.ai" level="WARN"/>
    <logger name="io.lettuce" level="WARN"/>
    <logger name="com.netflix.eureka" level="WARN"/>
    <logger name="com.netflix.discovery" level="WARN"/>
    <logger name="org.springframework.cloud" level="WARN"/>
    <logger name="io.github.resilience4j" level="WARN"/>

    <!-- ══════════════════════════════════════════════════════════
         DEV OVERRIDES
     ══════════════════════════════════════════════════════════ -->
    <springProfile name="dev">
        <logger name="com.nexus.notification" level="DEBUG"/>
        <logger name="org.springframework.data.mongodb" level="DEBUG"/>
        <logger name="org.springframework.kafka" level="DEBUG"/>
        <logger name="org.springframework.ai" level="DEBUG"/>
    </springProfile>

    <!-- ══════════════════════════════════════════════════════════
         ROOT
     ══════════════════════════════════════════════════════════ -->
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
        <springProfile name="docker,production">
            <appender-ref ref="ASYNC_LOKI"/>
        </springProfile>
    </root>

</configuration>
